{
    "prefix": "AMOS22 Abdominal Organ Segmentation",
    "dataset": "amos22",
    "data_dir": "./datasets/amoss22",
    "memory_size": 0,
    "memory_per_class": 0,
    "fixed_memory": false,
    "shuffle": false,
    "init_cls": 4,
    "increment": 3,
    "model_name": "mote_seg",
    "backbone_type": "swin_unetr_mote_base",
    "device": ["0"],
    "seed": [1993],

    "init_epochs": 150,
    "init_lr": 0.0001,
    "later_epochs": 100,
    "later_lr": 0.00005,
    "batch_size": 2,
    "weight_decay": 0.00001,
    "min_lr": 0.000001,
    "optimizer": "adamw",
    "scheduler": "cosine",
    "pretrained": true,

    "ffn_num": 64,
    "d_model": 768,
    "use_diagonal": false,
    "alpha": 0.005,
    "use_init_ptm": false,
    "beta": 0,

    "roi_size": [96, 96, 96],
    "sw_batch_size": 4,
    "overlap": 0.5,
    "use_dice_ce": true,
    "val_interval": 5,

    "moni_adam": false,
    "adapter_num": -1,
    "print_forget": true,

    "num_classes": 16,
    "in_channels": 1,
    "task_type": "segmentation",
    "use_validation": true,

    "_comment_classes": "AMOS22 has 16 classes: 0=background, 1=spleen, 2=right kidney, 3=left kidney, 4=gallbladder, 5=esophagus, 6=liver, 7=stomach, 8=aorta, 9=IVC, 10=pancreas, 11=right adrenal, 12=left adrenal, 13=duodenum, 14=bladder, 15=prostate/uterus",
    "_comment_tasks": "Task 0: background + spleen + right kidney + left kidney (4 classes), Then add 3 classes per task"
}
